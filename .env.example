# ==========================================
# 核心环境配置 (Environment Configuration)
# ==========================================
APP_ENV=development
PROJECT_NAME="FastAPI LangGraph Agent"
VERSION=1.0.0
DEBUG=true

# ==========================================
# API & 安全设置 (API & Security)
# ==========================================
API_V1_STR=/api/v1
# 允许跨域的域名列表，生产环境请修改为实际域名
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# ==========================================
# JWT 认证设置 (Authentication)
# ==========================================
# 【重要】生产环境请用 `openssl rand -hex 32` 生成随机长字符串替换此处
JWT_SECRET_KEY="your-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ==========================================
# 数据库设置 (PostgreSQL + pgvector)
# ==========================================
# Docker 环境下固定为 db，本地运行填 localhost
POSTGRES_HOST=db
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ==========================================
# 大模型服务 (LLM - SiliconFlow/OpenAI Compatible)
# ==========================================
# 默认使用硅基流动 API，您可以在此注册: https://cloud.siliconflow.cn/
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY="sk-your-llm-api-key"
DEFAULT_LLM_MODEL=deepseek-ai/DeepSeek-V3
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4000
MAX_LLM_CALL_RETRIES=3

# ==========================================
# Langfuse 可观测性监控 (Observability)
# ==========================================
# 注册地址: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# 工具箱配置 (Agent Tools)
# ==========================================
# 1. Tavily 联网搜索 (https://tavily.com/)
TAVILY_API_KEY="tvly-your-tavily-api-key"

# 2. RAG 知识库
RAG_COLLECTION_NAME=rag_knowledge_base
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_UPLOAD_DIR=uploads
RAG_MAX_FILE_SIZE_MB=50

# 3. 长期记忆 (Long-term Memory)
LONG_TERM_MEMORY_MODEL=deepseek-ai/DeepSeek-V3
LONG_TERM_MEMORY_EMBEDDER_MODEL=BAAI/bge-m3
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# 4. 短期记忆摘要阈值 (超过多少条消息开始压缩)
SUMMARY_THRESHOLD=10

# 5. 邮件发送服务 (SMTP) - 支持 QQ/网易等邮箱
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER="your-email@qq.com"
# 注意：这里填写的是授权码，不是登录密码
EMAIL_SMTP_PASSWORD="your-smtp-auth-code"
EMAIL_SMTP_USE_SSL=true
EMAIL_FROM_NAME="AI 智能助手"

# ==========================================
# 速率限制配置 (Rate Limiting)
# ==========================================
RATE_LIMIT_DEFAULT="1000 per day, 200 per hour"

# ==========================================
# 自动化评估配置 (Evals)
# ==========================================
EVALUATION_LLM=Qwen/Qwen3-32B
EVALUATION_BASE_URL=https://api.siliconflow.cn/v1
EVALUATION_API_KEY="sk-your-llm-api-key"
EVALUATION_SLEEP_TIME=10