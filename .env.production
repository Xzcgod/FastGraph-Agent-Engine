# ==========================================
# 生产环境配置（阿里云轻量服务器 2核2GB 精简部署）
# 复制为 .env.production 后，替换所有占位符再启动。
# ==========================================
APP_ENV=production
PROJECT_NAME="FastGraph Agent"
VERSION=1.0.0
DEBUG=false

# ==========================================
# API & 安全设置
# ==========================================
API_V1_STR=/api/v1
# 生产环境改为你的实际域名/前端地址
ALLOWED_ORIGINS="http://47.122.117.96"
# 平台管理员邮箱白名单（填真实管理员邮箱）
PLATFORM_ADMIN_EMAILS="admin@example.com"

# ==========================================
# Knowledge Service（知识库微服务）
# ==========================================
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8010
KNOWLEDGE_SERVICE_TOKEN="change-me-production-knowledge-token"
KNOWLEDGE_SERVICE_CONNECT_TIMEOUT_SECONDS=5
KNOWLEDGE_SERVICE_REQUEST_TIMEOUT_SECONDS=120

# ---- embedding：provider=api 走外部 API（SiliconFlow），不跑本地 Ollama ----
KNOWLEDGE_EMBEDDING_PROVIDER=api
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KNOWLEDGE_EMBEDDING_API_KEY="sk-your-siliconflow-key"
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
# rerank 可选，留空则关闭精排（省一次外部调用）
KNOWLEDGE_RERANKER_BASE_URL=
KNOWLEDGE_RERANKER_API_KEY=
KNOWLEDGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

KNOWLEDGE_MAX_FILE_SIZE_MB=50
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=100
# 2GB 内存下降低批量与并发
KNOWLEDGE_EMBEDDING_BATCH_SIZE=8
KNOWLEDGE_DATABASE_POOL_SIZE=5
KNOWLEDGE_DATABASE_MAX_OVERFLOW=5
KNOWLEDGE_DATABASE_POOL_TIMEOUT_SECONDS=60
KNOWLEDGE_INGEST_CONCURRENCY=1
KNOWLEDGE_INGEST_RATE_LIMIT="10000 per hour"
KNOWLEDGE_ALLOWED_NAMESPACES=default,policy,customer_service

# ==========================================
# JWT 认证
# ==========================================
# 【重要】用 `openssl rand -hex 32` 生成随机串替换
JWT_SECRET_KEY="change-me-generate-with-openssl-rand-hex-32"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ==========================================
# 数据库（PostgreSQL + pgvector，跑在 docker-compose.prod.yml）
# ==========================================
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me-db-password
# 2GB 内存下把连接池调小
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5

# ==========================================
# 大模型服务（DeepSeek）
# ==========================================
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY="sk-otenjbgmdgrxfktkdjfjtfvmybuopvprnhevcntgjpiqvnwl"
DEFAULT_LLM_MODEL=deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4000
MAX_LLM_CALL_RETRIES=3

# ==========================================
# Langfuse 可观测性（Cloud）
# ==========================================
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# 工具箱
# ==========================================
TAVILY_API_KEY="tvly-your-tavily-api-key"
SUMMARY_THRESHOLD=10
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER="your-email@qq.com"
EMAIL_SMTP_PASSWORD="your-smtp-auth-code"
EMAIL_SMTP_USE_SSL=true
EMAIL_FROM_NAME="AI 智能助手"

# ==========================================
# 速率限制
# ==========================================
RATE_LIMIT_DEFAULT="1000 per day, 200 per hour"
